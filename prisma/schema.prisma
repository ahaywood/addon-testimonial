generator client {
  provider = "prisma-client"

  runtime                = "workerd"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"

  output          = "../generated/prisma"
  previewFeatures = ["queryCompiler", "driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}


model Credential {
  id            String   @id @default(uuid()) // Internal DB ID
  userId        String   @unique // Every credential is linked to a specific user
  user          User     @relation(fields: [userId], references: [id])
  createdAt     DateTime @default(now())
  credentialId  String   @unique // WebAuthn credential identifier
  publicKey     Bytes
  counter       Int      @default(0)
  
  @@index([credentialId])
  @@index([userId])
}

model Testimonial {
  id        String   @id @default(uuid())
  fullName String
  email String?
  company String?
  jobTitle String?
  avatar String?
  rating Int?
  content String?
  date DateTime?
  featured Boolean @default(false)
  url String?
  tags TestimonialTagging[]
  sourceId Int?
  source TestimonialSource? @relation(fields: [sourceId], references: [id])
  statusId Int @default(3)
  status TestimonialStatus @relation(fields: [statusId], references: [id])
  accountId String
  account TestimonialAccount @relation(fields: [accountId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TestimonialAccount {
  id        String   @id @default(uuid())
  notificationEmail String?
  notifyNewTestimonials Boolean @default(false)
  notifyWeeklyDigest Boolean @default(false)
  userId String @unique
  user User @relation(fields: [userId], references: [id])
  testimonials Testimonial[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model TestimonialSource {
  id Int @id @default(autoincrement())
  name String
  testimonials Testimonial[]
}

model TestimonialStatus {
  id Int @id @default(autoincrement())
  name String
  testimonials Testimonial[]
}

model TestimonialTag {
  id Int @id @default(autoincrement())
  name String
  color String?
  textColor String?
  testimonials TestimonialTagging[]
}

model TestimonialTagging {
  id Int @id @default(autoincrement())
  testimonialId String
  testimonial Testimonial @relation(fields: [testimonialId], references: [id])
  tagId Int
  tag TestimonialTag @relation(fields: [tagId], references: [id])
}

model User {
  id String @id @default(uuid())
  testimonialAccounts TestimonialAccount[]
  // Fields merged from another schema file
  username    String      @unique
  createdAt   DateTime    @default(now())
  credentials Credential[] // Relationship: One user can have many credentials
}