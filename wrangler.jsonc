{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "testimonials",
  "main": "src/worker.tsx",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "public"
  },
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSION_DURABLE_OBJECT",
        "class_name": "SessionDurableObject"
      },
      {
        "name": "TESTIMONIALS_DURABLE_OBJECT",
        "class_name": "TestimonialsDurableObject"
      }
    ]
  },
  "vars": {
    "WEBAUTHN_APP_NAME": "testimonials-addon"
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "SessionDurableObject",
        "TestimonialsDurableObject"
      ]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "__change_me__",
      "database_id": "__change_me__"
    }
  ],
  "r2_buckets": [
    {
      "bucket_name": "testimonials-addon",
      "binding": "testimonials_addon"
    }
  ]
}
