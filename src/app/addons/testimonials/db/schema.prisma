model Testimonial {
  id        String   @id @default(uuid())
  fullName String
  email String?
  company String?
  jobTitle String?
  avatar String?
  rating Int?
  content String?
  date DateTime?
  featured Boolean @default(false)
  url String?
  tags TestimonialTagging[]
  sourceId Int?
  source TestimonialSource? @relation(fields: [sourceId], references: [id])
  statusId Int @default(3)
  status TestimonialStatus @relation(fields: [statusId], references: [id])
  accountId String
  account TestimonialAccount @relation(fields: [accountId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TestimonialAccount {
  id        String   @id @default(uuid())
  notificationEmail String?
  notifyNewTestimonials Boolean @default(false)
  notifyWeeklyDigest Boolean @default(false)
  userId String @unique
  user User @relation(fields: [userId], references: [id])
  testimonials Testimonial[]
  stats TestimonialStats[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model TestimonialSource {
  id Int @id @default(autoincrement())
  name String
  testimonials Testimonial[]
}

model TestimonialStats {
  id Int @id @default(autoincrement())
  totalTestimonials Int @default(0)
  testimonialAccountId String
  testimonialAccount TestimonialAccount @relation(fields: [testimonialAccountId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TestimonialStatus {
  id Int @id @default(autoincrement())
  name String
  testimonials Testimonial[]
}

model TestimonialTag {
  id Int @id @default(autoincrement())
  name String
  color String?
  textColor String?
  testimonials TestimonialTagging[]
}

model TestimonialTagging {
  id Int @id @default(autoincrement())
  testimonialId String
  testimonial Testimonial @relation(fields: [testimonialId], references: [id])
  tagId Int
  tag TestimonialTag @relation(fields: [tagId], references: [id])
}

model User {
  id String @id @default(uuid())
  testimonialAccounts TestimonialAccount[]
}